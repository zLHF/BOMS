set -e

BASE_DIR=$(dirname "$0")
MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}
WRAPPER_DIR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
WRAPPER_PROPERTIES="$WRAPPER_DIR/maven-wrapper.properties"

if [ -z "$JAVA_HOME" ]; then
  JAVACMD=$(command -v java)
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVACMD" ]; then
  echo "Error: JAVA_HOME is not defined correctly or java is not on PATH." >&2
  exit 1
fi

if [ ! -f "$WRAPPER_PROPERTIES" ]; then
  echo "Error: Maven wrapper properties not found: $WRAPPER_PROPERTIES" >&2
  exit 1
fi

# Read wrapper properties without requiring non-POSIX tooling.
distributionUrl=$(sed -n 's/^distributionUrl=//p' "$WRAPPER_PROPERTIES" | tail -n 1)
wrapperUrl=$(sed -n 's/^wrapperUrl=//p' "$WRAPPER_PROPERTIES" | tail -n 1)

if [ -z "$distributionUrl" ]; then
  echo "Error: distributionUrl is missing from $WRAPPER_PROPERTIES" >&2
  exit 1
fi

if [ -z "$wrapperUrl" ]; then
  wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
fi

mkdir -p "$WRAPPER_DIR"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper jar from $wrapperUrl"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$wrapperUrl" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$wrapperUrl" -O "$WRAPPER_JAR"
  else
    echo "Error: neither curl nor wget is available to download Maven Wrapper." >&2
    exit 1
  fi
fi

exec "$JAVACMD" \
  -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
  -classpath "$WRAPPER_JAR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
