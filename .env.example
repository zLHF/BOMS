# BOMS environment example. Copy to .env or inject through your platform secret manager.
# Do not commit real passwords, access keys, or tokens.

# ---------- Backend ----------
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/boms?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=boms
SPRING_DATASOURCE_PASSWORD=change-me-db-password
BOMS_JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret
BOMS_JWT_EXPIRE_MINUTES=720
BOMS_DEMO_ALLOW_PLAIN_PASSWORD=false
BOMS_DEMO_PLAIN_PASSWORD=change-me-demo-password
LOGGING_LEVEL_COM_BOMS=INFO

# Batch import limit, default 10 MiB.
BOMS_IMPORT_MAX_FILE_SIZE_BYTES=10485760

# ---------- MinIO / Object Storage ----------
BOMS_MINIO_ENDPOINT=http://127.0.0.1:9100
BOMS_MINIO_ACCESS_KEY=change-me-minio-access-key
BOMS_MINIO_SECRET_KEY=change-me-minio-secret-key
BOMS_MINIO_BUCKET=boms-files

# ---------- Infrastructure used by deploy/docker-compose.yml ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=boms
MYSQL_USER=boms
MYSQL_PASSWORD=change-me-db-password
REDIS_PORT=6380
MINIO_ROOT_USER=change-me-minio-root-user
MINIO_ROOT_PASSWORD=change-me-minio-root-password

# ---------- Frontend ----------
# Development uses Vite proxy in frontend/vite.config.ts.
# Production nginx proxies /api/ and /open-api/ to the backend service name.
